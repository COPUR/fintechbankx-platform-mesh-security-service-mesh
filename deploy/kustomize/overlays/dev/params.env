# dev mesh parameters (placeholders until the VPC / DNS stacks publish outputs).
# Replace with the terraform outputs of the dev VPC and the real hostnames.
ENVIRONMENT=dev
AWS_REGION=me-central-1
IDENTITY_HOST=auth.dev.fintechbankx.example
API_HOST=api.dev.fintechbankx.example
# Monolith (enterprise-loan-management-system) host the cut-over routes R2/R4 send to; HTTPS, placeholder until its deployment target is decided.
LEGACY_OPEN_FINANCE_HOST=legacy-api.dev.fintechbankx.example
VPC_CIDR=10.10.0.0/16
AURORA_CIDR=10.10.32.0/20
MSK_CIDR=10.10.48.0/20
DOCDB_CIDR=10.10.64.0/20
REDIS_CIDR=10.10.80.0/20
INGRESS_SOURCE_CIDR=10.10.0.0/16
# IRSA role for ClusterSecretStore aws-secrets-manager-platform (placeholder account: AWS documentation example; replace with the terraform-modules output).
PLATFORM_SECRETS_ROLE_ARN=arn:aws:iam::111122223333:role/dev-external-secrets-platform
